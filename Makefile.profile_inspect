CC = gcc
CFLAGS = -Wall -Wextra -I. -Idrivers/iio/trx-rf/ad9088/public/inc
TARGET = profile_inspect
SRC = profile_inspect.c

all: $(TARGET)

$(TARGET): $(SRC)
	$(CC) $(CFLAGS) -o $(TARGET) $(SRC)

clean:
	rm -f $(TARGET)

run: $(TARGET)
	./$(TARGET) firmware/204C_M4_L4_NP16_20p0_4x4_FSRC.bin

.PHONY: all clean run
