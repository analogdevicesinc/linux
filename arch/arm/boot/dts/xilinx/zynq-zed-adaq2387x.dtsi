/*
 * EV-ADAQ2387xFMCZ on ZedBoard, running the adaq2387x HDL project.
 * Test only, not for submission.
 */
/dts-v1/;
#include "zynq-zed.dts"

#include <dt-bindings/interrupt-controller/irq.h>

/ {
	vref: regulator-vref {
		compatible = "regulator-fixed";
		regulator-name = "vref-4v096";
		regulator-min-microvolt = <4096000>;
		regulator-max-microvolt = <4096000>;
		regulator-always-on;
	};

	/* 120 MHz reference from the HDL clock wizard */
	ext_clk: clock-ext {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <120000000>;
	};

	fpga-bus {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		interrupt-parent = <&intc>;

		/* FMC I2C, FRU EEPROM on the evaluation board */
		i2c@41620000 {
			compatible = "xlnx,xps-iic-2.00.a";
			reg = <0x41620000 0x10000>;
			interrupts = <0 55 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clkc 15>;
			#address-cells = <1>;
			#size-cells = <0>;

			eeprom@50 {
				compatible = "atmel,24c02";
				reg = <0x50>;
			};
		};

		axi_adc: adc@44a00000 {
			compatible = "adi,axi-adc-10.0.a";
			reg = <0x44a00000 0x10000>;
			dmas = <&rx_dma 0>;
			dma-names = "rx";
			clocks = <&clkc 15>;
			#io-backend-cells = <0>;
		};

		rx_dma: dma-controller@44a30000 {
			compatible = "adi,axi-dmac-1.00.a";
			reg = <0x44a30000 0x1000>;
			#dma-cells = <1>;
			interrupts = <0 57 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clkc 15>;
		};

		axi_pwm_gen: pwm@44a60000 {
			compatible = "adi,axi-pwmgen-2.00.a";
			reg = <0x44a60000 0x1000>;
			#pwm-cells = <3>;
			clocks = <&clkc 15>, <&ext_clk>;
			clock-names = "axi", "ext";
		};
	};
};
