/*
 * Common pieces for ADAQ23878 (LTC2387-18, 18-bit) on Zedboard.
 *
 * Includes the carrier (adaq2387x.dtsi), sets the 32-bit DMA data path
 * (18-bit samples padded into 32-bit storage), and instantiates the ADC
 * node in default two-lane mode.
 *
 * Copyright (C) 2026 Analog Devices Inc.
 */

#include "zynq-zed-adv7511-adaq2387x.dtsi"

&rx_dma {
	adi,channels {
		#size-cells = <0>;
		#address-cells = <1>;

		dma-channel@0 {
			reg = <0>;
			adi,source-bus-width = <32>;
			adi,source-bus-type = <2>;
			adi,destination-bus-width = <64>;
			adi,destination-bus-type = <0>;
		};
	};
};

&fpga_axi {
	adaq23878: adc@0 {
		compatible = "adaq23878";
		clocks = <&ext_clk>;
		dmas = <&rx_dma 0>;
		dma-names = "rx";
		pwms = <&axi_pwm_gen 0 0>, <&axi_pwm_gen 1 0>;
		pwm-names = "cnv", "clk_en";
		vref-supply = <&vref>;
	};
};
