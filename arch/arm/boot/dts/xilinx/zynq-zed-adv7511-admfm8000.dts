/dts-v1/;

#include "zynq-zed.dtsi"
#include "zynq-zed-adv7511.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/iio/frequency/ad9508.h>

/ {
	adc_vdd_3v3: adc-vdd-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "adc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	adc_vdd_1v1: adc-vdd-1v1 {
		compatible = "regulator-fixed";
		regulator-name = "adc-1v1";
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		regulator-always-on;
	};

	adc_vref_3v: adc-vref-3v {
		compatible = "regulator-fixed";
		regulator-name = "adc-3v";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-always-on;
	};

	nanodac_vdd_3v3: nanodac-vdd-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "nanodac-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	nanodac_vref_2v5: nanodac-vref-2v5 {
		compatible = "regulator-fixed";
		regulator-name = "nanodac-2v5";
		regulator-min-microvolt = <2500000>;
		regulator-max-microvolt = <2500000>;
		regulator-always-on;
	};

	dds_reg_3v3: dds-reg-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "dds-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	dds_reg_1v8: dds-reg-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "dds-1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	pll_reg_3v3: pll-reg-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "pll-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	dsa_reg_3v3: dsa-reg-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "dsa-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	clocks {
		dds_clkin: clock-1ghz {
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <1000000000>; // 1GHz
		};

		pll_clkin: pll-clock {
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <80000000>; // 80MHz
		};
	};
};

&fpga_axi {
	tx_dma: tx-dmac@44a10000 {
		compatible = "adi,axi-dmac-1.00.a";
		reg = <0x44a10000 0x1000>;
		#dma-cells = <1>;
		interrupt-parent = <&intc>;
		interrupts = <0 29 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkc 15>; // fclk0
	};

	rx_dma: rx-dmac@44a40000 {
		compatible = "adi,axi-dmac-1.00.a";
		reg = <0x44a40000 0x10000>;
		#dma-cells = <1>;
		interrupts = <0 31 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkc 15>;
	};

	dds_backend: axi-ad9910@44a00000 {
		compatible = "adi,axi-ad9910";
		reg = <0x44a00000 0x10000>;
		#pwm-cells = <1>;
		dmas = <&tx_dma 0>;
		dma-names = "tx";
		interrupt-parent = <&intc>;
		interrupts = <0 30 IRQ_TYPE_LEVEL_HIGH>;
	};

	adc_a_backend: axi-adc@44a20000 {
		compatible = "adi,axi-ad408x";
		reg = <0x44a20000 0x10000>;
		dmas = <&rx_dma 0>;
		dma-names = "rx";
		clocks = <&clkc 15>;
		#io-backend-cells = <0>;
	};

	adc_b_backend: axi-adc@44a30000 {
		compatible = "adi,axi-ad408x";
		reg = <0x44a30000 0x10000>;
		clocks = <&clkc 15>;
		#io-backend-cells = <0>;
	};

	axi_spi_0: spi@44a60000 {
		reg = <0x44a60000 0x10000>;
		compatible = "xlnx,axi-quad-spi-1.00.a";
		bits-per-word = <8>;
		clock-names = "ext_spi_clk", "s_axi_aclk";
		clocks = <&clkc 15>, <&clkc 15>;
		fifo-size = <16>;
		interrupt-names = "ip2intc_irpt";
		interrupt-parent = <&intc>;
		interrupts = <0 32 IRQ_TYPE_LEVEL_HIGH>;
		num-cs = <0x2>;
		xlnx,num-ss-bits = <0x2>;
		#address-cells = <1>;
		#size-cells = <0>;

		clk0_ad9508: ad9508@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			#clock-cells = <1>;
			compatible = "adi,ad9508";
			reg = <0>;

			clocks = <&dds_clkin>;

			spi-max-frequency = <10000000>;
			clock-output-names = "ad9508-1_out0", "ad9508-1_out1",
					"ad9508-1_out2", "ad9508-1_out3";
			sync-gpios = <&gpio0 95 GPIO_ACTIVE_LOW>;

			ad9508_0_c0:channel@0 {
				reg = <0>;
				adi,extended-name = "CNV_B";
				adi,driver-mode = <(DRIVER_PHASE_NORMAL | DRIVER_MODE_LVDS_1_25)>;
				adi,divider-phase = <0>;
				adi,channel-divider = <160>;
			};

			ad9508_0_c1:channel@1 {
				reg = <1>;
				adi,extended-name = "CLK_B";
				adi,driver-mode = <(DRIVER_PHASE_NORMAL | DRIVER_MODE_LVDS_1_25)>;
				adi,divider-phase = <0>;
				adi,channel-divider = <16>;
			};

			ad9508_0_c2:channel@2 {
				reg = <2>;
				adi,extended-name = "CNV_A";
				adi,driver-mode = <(DRIVER_PHASE_NORMAL | DRIVER_MODE_LVDS_1_25)>;
				adi,divider-phase = <0>;
				adi,channel-divider = <160>;
			};

			ad9508_0_c3:channel@3 {
				reg = <3>;
				adi,extended-name = "CLK_A";
				adi,driver-mode = <(DRIVER_PHASE_NORMAL | DRIVER_MODE_LVDS_1_25)>;
				adi,divider-phase = <0>;
				adi,channel-divider = <16>;
			};
		};

		nanodac: ad5313r@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "adi,ad5313r";
			reg = <1>;
			spi-max-frequency = <10000000>;
			spi-cpha;
			vdd-supply = <&nanodac_vdd_3v3>;
			vlogic-supply = <&nanodac_vdd_3v3>;
			vref-supply = <&nanodac_vref_2v5>;
			adi,range-double;
		};
	};
};

&spi0 {
	status = "okay";

	dds: ad9910@0 {
		compatible = "adi,ad9910";
		reg = <0>;
		avdd18-supply = <&dds_reg_1v8>;
		avdd33-supply = <&dds_reg_3v3>;
		dvdd18-supply = <&dds_reg_1v8>;
		dvdd-io33-supply = <&dds_reg_3v3>;
		spi-max-frequency = <1000000>;
		clocks = <&dds_clkin>;
		clock-names = "ref_clk";

		reset-gpios = <&gpio0 91 0>;
		io-reset-gpios = <&gpio0 90 0>;
		powerdown-gpios = <&gpio0 92 0>;
		update-gpios = <&gpio0 93 0>;

		pwms = <&dds_backend 0>;
		pwm-names = "drctl";
		io-backends = <&dds_backend>;
	};

	pll: adf41513@1 {
		compatible = "adi,adf41513";
		reg = <1>;
		avdd1-supply = <&pll_reg_3v3>;
		avdd2-supply = <&pll_reg_3v3>;
		avdd3-supply = <&pll_reg_3v3>;
		avdd4-supply = <&pll_reg_3v3>;
		avdd5-supply = <&pll_reg_3v3>;
		vp-supply = <&pll_reg_3v3>;
		spi-max-frequency = <1000000>;
		clocks = <&pll_clkin>;
		enable-gpios = <&gpio0 86 GPIO_ACTIVE_HIGH>;
		adi,charge-pump-current-microamp = <4800>;
		adi,power-up-frequency-mhz = <1600>; /* 1.6 GHz */
	};

	dsa: adrf5703@2 {
		compatible = "adi,adrf5703";
		reg = <2>;
		vcc-supply = <&dsa_reg_3v3>;
		spi-max-frequency = <1000000>;
	};
};

&spi1 {
	status = "okay";

	adc_ad4880: adc@0 {
		compatible = "adi,ad4880";
		reg = <0>, <1>;

		spi-max-frequency = <10000000>;
		spi-cpol;
		spi-cpha;

		clocks = <&clk0_ad9508 2>;
		clock-names = "cnv";
		adi,lvds-cnv-enable;
		adi,num-lanes = <1>;
		vdd33-supply = <&adc_vdd_3v3>;
		vdd11-supply = <&adc_vdd_1v1>;
		iovdd-supply = <&adc_vdd_1v1>;
		vrefin-supply = <&adc_vref_3v>;
		io-backends = <&adc_a_backend>, <&adc_b_backend>;
	};
};
