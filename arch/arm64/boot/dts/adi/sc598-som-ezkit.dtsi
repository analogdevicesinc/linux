/dts-v1/;

#include "sc598-som-revE.dtsi"

/ {
	model = "ADI 64-bit SC598 SOM EZ Kit";
	compatible = "adi,sc598-som-ezkit", "adi,sc59x-64";

	sound_mux: dac-mux-controller {
		compatible = "gpio-mux";
		#mux-state-cells = <1>;
		mux-gpios = <&crr_gpio_expander 6 GPIO_ACTIVE_LOW>, /* DAC enable */
			    <&crr_gpio_expander 7 GPIO_ACTIVE_LOW>; /* ADC enable */
		idle-state = <0>;
	};

	pinmux-sound {
		compatible = "pinctrl-multiplexer";

		dac_en_state: dac-grp {
			mux-states = <&sound_mux 1>;
		};

		adc_en_state: adc-grp {
			mux-states = <&sound_mux 2>;
		};

		adc_dac_en_state: adc-dac-grp {
			mux-states = <&sound_mux 3>;
		};
	};

	sound {
		compatible = "audio-graph-card2";
		/* links = <&sound_i2s4>; */
		links = <&i2s4_port>;
		widgets = "Headphone", "Headphones",
			  "Line", "DAC1",
			  "Line", "DAC2",
			  "Line", "DAC3",
			  "Line", "DAC4",
			  "Line", "DAC5",
			  "Line", "DAC6",
			  "Line", "DAC7",
			  "Line", "DAC8",
			  "Line", "DAC9",
			  "Line", "DAC10",
			  "Line", "DAC11",
			  "Line", "DAC12",
			  "Line", "AN1",
			  "Line", "AN2",
			  "Line", "AN3",
			  "Line", "AN4";
		routing = "Headphones", "DAC AOUT1",
			  "Headphones", "DAC AOUT2",
			  "DAC1", "DAC AOUT1",
			  "DAC2", "DAC AOUT2",
			  "DAC3", "DAC AOUT3",
			  "DAC4", "DAC AOUT4",
			  "DAC5", "DAC AOUT5",
			  "DAC6", "DAC AOUT6",
			  "DAC7", "DAC AOUT7",
			  "DAC8", "DAC AOUT8",
			  "DAC9", "DAC AOUT9",
			  "DAC10", "DAC AOUT10",
			  "DAC11", "DAC AOUT11",
			  "DAC12", "DAC AOUT12",
			  "ADC AIN1", "AN1",
			  "ADC AIN2", "AN2",
			  "ADC AIN3", "AN3",
			  "ADC AIN4", "AN4";

		multi {
			#address-cells = <1>;
			#size-cells = <0>;

			ports@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;
				dai-format = "dsp_a";
				dai-tdm-slot-num = <8>;
				dai-tdm-slot-width = <32>;

				sound_i2s4: port@0 {
					reg = <0>;

					sound_i2s4_ep: endpoint {
						remote-endpoint = <&i2s4_ep>;
					};
				};

				port@1 {
					reg = <1>;

					sound_adc_ep: endpoint {
						remote-endpoint = <&adc_ep>;
						system-clock-frequency = <24576000>; /* ADAU1962 MCLKO */
						frame-master;
						bitclock-master;
					};
				};

				port@2 {
					reg = <2>;

					sound_dac_ep: endpoint {
						remote-endpoint = <&dac_ep>;
						clocks = <&audio_clk>;
						frame-master;
						bitclock-master;
					};
				};
			};
		};
	};
};

&gpa {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "boot-trace";
};

&ospi {
	pinctrl-names = "default";
	pinctrl-0 = <&ospi_default>;

	status = "disabled";

	flash@0 {
		compatible = "mxicy,mx66lm1g45", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <83333334>;
		spi-tx-bus-width = <8>;
		spi-rx-bus-width = <8>;

		cdns,read-delay = <4>;
		cdns,tshsl-ns = <50>;
		cdns,tsd2d-ns = <50>;
		cdns,tchsh-ns = <4>;
		cdns,tslch-ns = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			ospi_0: partition@0 {
				label = "u-boot-spl";
				reg = <0x0 0x40000>;
			};

			ospi_1: partition@40000 {
				label = "u-boot";
				reg = <0x40000 0xc0000>;
			};

			ospi_2: partition@100000 {
				label = "kernel";
				reg = <0x100000 0xf00000>;
			};

			ospi_3: partition@1000000 {
				label = "rootfs";
				reg = <0x1000000 0x1000000>;
			};
		};
	};
};

&i2c2 {
	crr_gpio_expander: gpio@22 {
		compatible = "microchip,mcp23017";
		gpio-controller;
		#gpio-cells = <2>;
		reg = <0x22>;
		status = "okay";

		eeprom {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "eeprom-en";
		};

		pushbutton {
			gpio-hog;
			gpios = <1 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "pushbutton-en";
		};

		microsd {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "microsd-spi";
		};

		ftdi {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "ftdi-usb-en";
		};

		can {
			gpio-hog;
			gpios = <4 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "can-en";
		};

		octal {
			gpio-hog;
			gpios = <8 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "octal-spi-cs-en";
		};

		spdif-dig {
			gpio-hog;
			gpios = <9 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "spdif-digital-en";
		};

		spdif-opt {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "spdif-optical-en";
		};

		mlb {
			gpio-hog;
			gpios = <12 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "mlb-en";
		};

		eth1 {
			gpio-hog;
			gpios = <13 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "eth1-en";
		};

		eth1-reset {
			gpio-hog;
			gpios = <14 GPIO_ACTIVE_LOW>;
			/* USB0 lines are shared with Eth1 so Eth PHY must be held in reset
			 * when using the USB
			 */
			output-high;
			line-name = "eth1-reset";
		};

		gige-reset {
			gpio-hog;
			gpios = <15 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "gige-reset";
		};
	};

	adc: audio-codec@11 {
		compatible = "adi,adau1979";
		reg = <0x11>;
		pinctrl-names = "default";
		pinctrl-0 = <&adc_dac_en_state>;
		reset-gpios = <&crr_gpio_expander 5 GPIO_ACTIVE_HIGH>;
		sound-name-prefix = "ADC";

		port {
			adc_ep: endpoint {
				remote-endpoint = <&sound_adc_ep>;
			};
		};
	};

	dac: audio-codec@4 {
		compatible = "adi,adau1962";
		reg = <0x4>;
		pinctrl-names = "default";
		/* pinctrl-0 = <&adc_dac_en_state>; */
		/* reset-gpios = <&crr_gpio_expander 5 GPIO_ACTIVE_LOW>; */
		sound-name-prefix = "DAC";

		port {
			dac_ep: endpoint {
				remote-endpoint = <&sound_dac_ep>;
			};
		};
	};
};

&emac0 {
	snps,reset-active-low;
	snps,reset-delays-us = <0 200 500>;
	phy-handle = <&dp83867>;
	phy-mode = "rgmii-id";
	pinctrl-names = "default";
	pinctrl-0 = <&eth0_default>;
	status = "okay";
	snps,mtl-rx-config = <&emac0rxconfig>;
	snps,mtl-tx-config = <&emac0txconfig>;

	emac0txconfig: tx-config {
		snps,tx-queues-to-use = <3>;

		queue0 {
			snps,dcb-algorithm;
		};

		queue1 {
			snps,dcb-algorithm;
		};

		queue2 {
			snps,dcb-algorithm;
		};
	};

	emac0rxconfig: rx-config {
		snps,rx-queues-to-use = <1>;

		queue0 {
			snps,dcb-algorithm;
		};

		queue1 {
			snps,dcb-algorithm;
		};

		queue2 {
			snps,dcb-algorithm;
		};
	};

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		dp83867: ethernet-phy@0 {
			reg = <0>;
			ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_8_B_NIB>;
			ti,dp83867-rxctrl-strap-quirk;
		};
	};
};

