#include "sc846-som.dts"

&pinctrl {
	eth0_default: eth0-default-pins {
		pinmux = <ADSP_SC846_PG00__ETH0_MDC
			  ADSP_SC846_PG01__ETH0_MDIO
			  ADSP_SC846_PG02__ETH0_RXD0
			  ADSP_SC846_PG03__ETH0_RXD1
			  ADSP_SC846_PG04__ETH0_RXCLK_REFCLK
			  ADSP_SC846_PG05__ETH0_RXCTL_RXDV
			  ADSP_SC846_PG06__ETH0_TXD0
			  ADSP_SC846_PG07__ETH0_TXD1
			  ADSP_SC846_PG08__ETH0_RXD2
			  ADSP_SC846_PG09__ETH0_RXD3
			  ADSP_SC846_PG10__ETH0_TXCTL_TXEN
			  ADSP_SC846_PG11__ETH0_TXCLK
			  ADSP_SC846_PG12__ETH0_TXD2
			  ADSP_SC846_PG13__ETH0_TXD3>;
	};

	i2c2_pins: i2c2-default-pins {
		pinmux = <ADSP_SC846_PA12__TWI2_SCL
			  ADSP_SC846_PA13__TWI2_SDA>;
	};
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;

	crr_gpio_expander: gpio@30 {
		compatible = "adi,adp5587";
		gpio-controller;
		#gpio-cells = <2>;
		reg = <0x30>;

		eth0-reset-hog {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "eth0-reset";
		};

		spdif1-en-hog {
			gpio-hog;
			gpios = <1 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "spdif1-en";
		};

		adau1966-reset-som-a-hog {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "adau1966-reset-som-a";
		};

		adau1979-a-reset-som-a-hog {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "adau1979-a-reset-som-a";
		};

		adau1979-b-reset-som-a-hog {
			gpio-hog;
			gpios = <4 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "adau1979-b-reset-som-a";
		};

		pushbutton-b-en-hog {
			gpio-hog;
			gpios = <5 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "pushbutton-b-en";
		};

		spdif1-opt-en-hog {
			gpio-hog;
			gpios = <6 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "spdif1-opt-en";
		};

		spdif1-coax-en-hog {
			gpio-hog;
			gpios = <7 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "spdif1-coax-en";
		};

		adc1-route-hog {
			gpio-hog;
			gpios = <8 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "adc1-route";
		};

		adc2-route-hog {
			gpio-hog;
			gpios = <9 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "adc2-route";
		};

		dac-route-hog {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "dac-route";
		};

		dai1-route-hog {
			gpio-hog;
			gpios = <11 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "dai1-route";
		};

		qspi-route-hog {
			gpio-hog;
			gpios = <12 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "qspi-route";
		};

		a2b1-io1-hog {
			gpio-hog;
			gpios = <13 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "a2b1-io1";
		};

		a2b1-io2-hog {
			gpio-hog;
			gpios = <14 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "a2b1-io2";
		};

		a2b1-io7-hog {
			gpio-hog;
			gpios = <15 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "a2b1-io7";
		};

		a2b2-io1-hog {
			gpio-hog;
			gpios = <16 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "a2b2-io1";
		};

		a2b2-io2-hog {
			gpio-hog;
			gpios = <17 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "a2b2-io2";
		};
	};
};

&emac0 {
	phy-handle = <&adin1300>;
	phy-mode = "rgmii-id";
	pinctrl-names = "default";
	pinctrl-0 = <&eth0_default>;
	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		adin1300: ethernet-phy@0 {
			reg = <0>;
		};
	};
};

&gpa {
	gpio-line-names =
		"", "", "", "", "", "", "boot-trace";
};
