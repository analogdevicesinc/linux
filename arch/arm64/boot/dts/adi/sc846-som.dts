/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/adi-adsp.h>
#include <dt-bindings/soc/adi/sc5xx-tru.h>
#include <dt-bindings/pinctrl/adi-adsp-sru.h>

#include "sc846.dtsi"

/ {
	chosen {
		stdout-path = &uart0;
	};
};

&scb {
	sharcfx: sharcfx@28240000 {
		compatible = "adi,remoteproc";
		reg = <0x28240000 0x90000>,
				<0x20400000 0x400000>;
		core-id = <1>;
		core-irq = <321>; /* SOFT1 */
		firmware-name = "adi_adsp_core1_fw.ldr";
		interrupts = <GIC_SPI 352 IRQ_TYPE_EDGE_RISING>; /* TRU0_RCV3 */
		adi,svect = <&rcu 0x30>;
		resets = <&rcu 1 0>, <&rcu 1 1>;
		reset-names = "crst", "start";
		mboxes = <&tru 171>; /* trigger master SOFT4 */
		mbox-names = "kick";
		adi,l1-da = <0x2f780000 0x2f810000>;
		adi,l2-da = <0x20400000 0x20800000>;
		adi,rsc-table = <&rsc_tbl0>;
		vdev-vring = <&vdev0vrings>;
		adi,verify = <1>;
		adi,tru = <&tru>;
		adi,tru-master-id = <ADI_TRU_MST_SOFT(4)>;
		status = "okay";
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_default>;
	status = "okay";
};

&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;
	status = "okay";

	gpio_expander: gpio@34 {
		compatible = "adi,adp5587";
		gpio-controller;
		#gpio-cells = <2>;
		reg = <0x34>;

		uart0-flow {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "uart0-flow-en";
		};

		uart0 {
			gpio-hog;
			gpios = <1 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "uart0-en";
		};

		sd-card-en {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "sd-card-en";
		};

		usb-phy-reset {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "usb-phy-reset";
		};

		led-ds4 {
			gpio-hog;
			gpios = <15 GPIO_ACTIVE_LOW >;
			output-high;
			line-name = "led-ds4";
		};

		led-ds3 {
			gpio-hog;
			gpios = <16 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "led-ds3";
		};

		led-ds2 {
			gpio-hog;
			gpios = <17 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "led-ds2";
		};
	};
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_default>;
	cs-gpios = <&gpd 2 GPIO_ACTIVE_LOW>;
	//bus-num = <2>;
	status = "okay";

	som_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot spl";
				reg = <0x00000000 0x40000>;
			};

			partition@40000 {
				label = "u-boot proper";
				reg = <0x00040000 0xc0000>;
			};

			partition@100000 {
				label = "kernel";
				reg = <0x00100000 0x2000000>;
			};

			partition@2100000 {
				label = "rootfs";
				reg = <0x2100000 0xdf00000>;
			};
		};
	};
};

&pinctrl0 {
	status = "okay";
	uart0_default: uart0_default_pins {
		pins {
			pinmux = <ADI_ADSP_PINMUX('A', 0, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('A', 1, ADI_ADSP_PINFUNC_ALT0)>;
		};
	};
	uart0_hwflow: uart0_hwflow_pins {
		pins {
			pinmux = <ADI_ADSP_PINMUX('A', 2, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('A', 3, ADI_ADSP_PINFUNC_ALT0)>;
		};
	};
	spi0_default: spi0_default_pins {
		pins {
			pinmux = <ADI_ADSP_PINMUX('E', 5,  ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('D', 14, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('E', 6,  ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('D', 15, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('E', 4,  ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('D', 11, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('D', 13, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('E', 0,  ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('E', 2,  ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('D', 10, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('D', 12, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('E', 1,  ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('E', 3,  ADI_ADSP_PINFUNC_ALT0)>;
		};
	};
	spi1_default: spi1_default_pins {
		pins {
			pinmux = <ADI_ADSP_PINMUX('D', 0, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('D', 1, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('D', 2, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('B', 10, ADI_ADSP_PINFUNC_ALT2)>,
				 <ADI_ADSP_PINMUX('B', 11, ADI_ADSP_PINFUNC_ALT2)>,
				 <ADI_ADSP_PINMUX('C', 15, ADI_ADSP_PINFUNC_ALT0)>;
		};
	};
	i2c5_pins: i2c5_default_pins {
		pins {
			pinmux = <ADI_ADSP_PINMUX('B', 2, ADI_ADSP_PINFUNC_ALT0)>,
				 <ADI_ADSP_PINMUX('B', 3, ADI_ADSP_PINFUNC_ALT0)>;
		};
	};
};
