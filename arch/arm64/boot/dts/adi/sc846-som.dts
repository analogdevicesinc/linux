/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/adi,adsp-sc846-pinctrl.h>
#include <dt-bindings/soc/adi/sc5xx-tru.h>
#include <dt-bindings/pinctrl/adi-adsp-sru.h>

#include "sc846.dtsi"

/ {
	chosen {
		stdout-path = &uart0;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		vdev0vrings: vdev0vring0@20400000 {
			reg = <0x20400000 0x4000>;
			no-map;
		};

		rsc_tbl0: rsc_tbl0@20404000 {
			reg = <0x20404000 0x400>;
			no-map;
		};
	};
};

&scb {
	sharc0: core1-rproc@28240000 {
		compatible = "adi,adsp-sc846-rproc";
		reg = <0x28240000 0x160000>,
				<0x20000000 0x200000>;
		core-id = <1>;
		core-irq = <321>; /* SOFT1 */
		firmware-name = "adi/rpmsg_echo_sharc_core1.ldr";
		interrupts = <GIC_SPI 352 IRQ_TYPE_EDGE_RISING>; /* TRU0_RCV3 */
		adi,rcu = <&rcu>;
		adi,l1-da = <0x240000 0x3a0000>;
		adi,l2-da = <0x20000000 0x20200000>;
		adi,rsc-table = <&rsc_tbl0>;
		adi,tru = <&tru>;
		adi,tru-master-id = <ADI_TRU_MST_SOFT(4)>;
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_default>;
	status = "okay";
};

&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;
	status = "okay";

	gpio_expander: gpio@34 {
		compatible = "adi,adp5587";
		gpio-controller;
		#gpio-cells = <2>;
		reg = <0x34>;

		uart0-flow-hog {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "uart0-flow-en";
		};

		uart0-hog {
			gpio-hog;
			gpios = <1 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "uart0-en";
		};

		sd-card-en-hog {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "sd-card-en";
		};

		usb-phy-reset-hog {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "usb-phy-reset";
		};

		led-ds4-hog {
			gpio-hog;
			gpios = <15 GPIO_ACTIVE_LOW >;
			output-high;
			line-name = "led-ds4";
		};

		led-ds3-hog {
			gpio-hog;
			gpios = <16 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "led-ds3";
		};

		led-ds2-hog {
			gpio-hog;
			gpios = <17 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "led-ds2";
		};
	};
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_default>;
	cs-gpios = <&gpd 2 GPIO_ACTIVE_LOW>;
	//bus-num = <2>;
	status = "okay";

	som_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot spl";
				reg = <0x00000000 0x40000>;
			};

			partition@40000 {
				label = "u-boot proper";
				reg = <0x00040000 0xc0000>;
			};

			partition@100000 {
				label = "kernel";
				reg = <0x00100000 0x2000000>;
			};

			partition@2100000 {
				label = "rootfs";
				reg = <0x2100000 0xdf00000>;
			};
		};
	};
};

&pinctrl {
	uart0_default: uart0-default-pins {
		pinmux = <ADSP_SC846_PA00__UART0_TX
			  ADSP_SC846_PA01__UART0_RX>;
	};

	uart0_hwflow: uart0-hwflow-pins {
		pinmux = <ADSP_SC846_PA02__UART0_RTS
			  ADSP_SC846_PA03__UART0_CTS>;
	};

	spi0_default: spi0-default-pins {
		pinmux = <ADSP_SC846_PE05__XSPI0_SEL1
			  ADSP_SC846_PD14__XSPI0_CLK
			  ADSP_SC846_PE06__XSPI0_SEL2
			  ADSP_SC846_PD15__XSPI0_CLK
			  ADSP_SC846_PE04__XSPI0_DQS_RWDS
			  ADSP_SC846_PD11__XSPI0_COTI
			  ADSP_SC846_PD13__XSPI0_D3
			  ADSP_SC846_PE00__XSPI0_D4
			  ADSP_SC846_PE02__XSPI0_D6
			  ADSP_SC846_PD10__XSPI0_CITO
			  ADSP_SC846_PD12__XSPI0_D2
			  ADSP_SC846_PE01__XSPI0_D5
			  ADSP_SC846_PE03__XSPI0_D7>;
	};

	spi1_default: spi1-default-pins {
		pinmux = <ADSP_SC846_PD00__SPI1_CITO
			  ADSP_SC846_PD01__SPI1_COTI
			  ADSP_SC846_PD02__SPI1_SEL1
			  ADSP_SC846_PB10__SPI1_D2
			  ADSP_SC846_PB11__SPI1_D3
			  ADSP_SC846_PC15__SPI1_CLK>;
	};

	i2c5_pins: i2c5-default-pins {
		pinmux = <ADSP_SC846_PB02__TWI5_SCL
			  ADSP_SC846_PB03__TWI5_SDA>;
	};
};
