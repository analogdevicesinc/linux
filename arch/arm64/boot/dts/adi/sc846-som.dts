/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/adi,adsp-sc846-pinctrl.h>
#include <dt-bindings/soc/adi/sc5xx-tru.h>
#include <dt-bindings/pinctrl/adi-adsp-sru.h>

#include "sc846.dtsi"

/ {
	chosen {
		stdout-path = &uart0;
	};

	reg_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_vdd_ext: regulator-vdd-ext {
		compatible = "regulator-fixed";
		regulator-name = "VDD_EXT";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		vin-supply = <&reg_3v3>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		vdev0vrings: vdev0vring0@20400000 {
			reg = <0x20400000 0x4000>;
			no-map;
		};

		rsc_tbl0: rsc_tbl0@20404000 {
			reg = <0x20404000 0x400>;
			no-map;
		};
	};
};

&scb {
	remoteproc { // XXX find a better name than "remoteproc"
		compatible = "simple-bus";

		#address-cells = <2>;
		#size-cells = <1>;

		/*
		 * Translations between ARM and SHARC. Each item
		 * consists of SHARC id, SHARC's address base,
		 * corresponding ARM address base and region size.
		 */
		ranges = <0x0 0x2f780000 0x28240000 0x00090000>,
			 <0x0 0x20400000 0x20400000 0x00400000>;

		sharc@0 {
			compatible = "adi,adsp-sc846-rproc";
			reg = <0x0 0x28240000 0x00090000>,
			      <0x0 0x20400000 0x00400000>;
			reg-names = "l1", "l2";
			core-id = <1>;
			core-irq = <321>; /* SOFT1 */
			firmware-name = "adi/rpmsg_echo_sharc_core1.ldr";
			interrupts = <GIC_SPI 352 IRQ_TYPE_EDGE_RISING>; /* TRU0_RCV3 */
			adi,svect = <&rcu 0x30>;
			resets = <&rcu 1 0>, <&rcu 1 1>;
			reset-names = "crst", "start";
			mboxes = <&tru 171>; /* trigger master SOFT4 */
			mbox-names = "kick";
			adi,rsc-table = <&rsc_tbl0>;
			vdev-vring = <&vdev0vrings>;
			adi,tru = <&tru>;
			adi,tru-master-id = <ADI_TRU_MST_SOFT(4)>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_default>;
	status = "okay";
};

&mmc0 {
	vmmc-supply = <&reg_3v3>;
	vqmmc-supply = <&reg_vdd_ext>;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";
};

&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;
	status = "okay";

	gpio_expander: gpio@34 {
		compatible = "adi,adp5587";
		gpio-controller;
		#gpio-cells = <2>;
		reg = <0x34>;

		uart0-flow-hog {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "uart0-flow-en";
		};

		uart0-hog {
			gpio-hog;
			gpios = <1 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "uart0-en";
		};

		sd-card-en-hog {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "sd-card-en";
		};

		usb-phy-reset-hog {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "usb-phy-reset";
		};

		led-ds4-hog {
			gpio-hog;
			gpios = <15 GPIO_ACTIVE_LOW >;
			output-high;
			line-name = "led-ds4";
		};

		led-ds3-hog {
			gpio-hog;
			gpios = <16 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "led-ds3";
		};

		led-ds2-hog {
			gpio-hog;
			gpios = <17 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "led-ds2";
		};
	};
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_default>;
	#address-cells = <0>;
	spi-slave;
	status = "okay";
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_default>;
	//bus-num = <2>;
	status = "okay";

	som_flash: flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot spl";
				reg = <0x00000000 0x40000>;
			};

			partition@40000 {
				label = "u-boot proper";
				reg = <0x00040000 0xc0000>;
			};

			partition@100000 {
				label = "kernel";
				reg = <0x00100000 0x2000000>;
			};

			partition@2100000 {
				label = "rootfs";
				reg = <0x2100000 0xdf00000>;
			};
		};
	};
};

&xspi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&xspi0_default>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <125000000>;
		spi-tx-bus-width = <8>;
		spi-rx-bus-width = <8>;
		m25p,fast-read;
		label = "xspi0-nor";
	};
};

&pinctrl {
	uart0_default: uart0-default-pins {
		pinmux = <ADSP_SC846_PA00__UART0_TX
			  ADSP_SC846_PA01__UART0_RX>;
	};

	uart0_hwflow: uart0-hwflow-pins {
		pinmux = <ADSP_SC846_PA02__UART0_RTS
			  ADSP_SC846_PA03__UART0_CTS>;
	};

	xspi0_default: xspi0-default-pins {
		pinmux = <ADSP_SC846_PE05__XSPI0_SEL1
			  ADSP_SC846_PD14__XSPI0_CLK
			  ADSP_SC846_PE06__XSPI0_SEL2
			  ADSP_SC846_PD15__XSPI0_CLK
			  ADSP_SC846_PE04__XSPI0_DQS_RWDS
			  ADSP_SC846_PD11__XSPI0_COTI
			  ADSP_SC846_PD10__XSPI0_CITO
			  ADSP_SC846_PD12__XSPI0_D2
			  ADSP_SC846_PD13__XSPI0_D3
			  ADSP_SC846_PE00__XSPI0_D4
			  ADSP_SC846_PE01__XSPI0_D5
			  ADSP_SC846_PE02__XSPI0_D6
			  ADSP_SC846_PE03__XSPI0_D7>;
	};

	xspi1_default: xspi1-default-pins {
		pinmux = <ADSP_SC846_PF02__XSPI1_SEL1
			  ADSP_SC846_PE11__XSPI1_CLK
			  ADSP_SC846_PF03__XSPI1_SEL2
			  ADSP_SC846_PE12__XSPI1_CLK
			  ADSP_SC846_PF01__XSPI1_DQS_RWDS
			  ADSP_SC846_PE08__XSPI1_COTI
			  ADSP_SC846_PE07__XSPI1_CITO
			  ADSP_SC846_PE09__XSPI1_D2
			  ADSP_SC846_PE10__XSPI1_D3
			  ADSP_SC846_PE13__XSPI1_D4
			  ADSP_SC846_PE14__XSPI1_D5
			  ADSP_SC846_PE15__XSPI1_D6
			  ADSP_SC846_PF00__XSPI1_D7>;
	};

	spi0_default: spi0-default-pins {
		pinmux = <ADSP_SC846_PC09__SPI0_CLK
			  ADSP_SC846_PC10__SPI0_CITO
			  ADSP_SC846_PC11__SPI0_COTI
			  ADSP_SC846_PC12__SPI0_SEL1>;
	};

	spi1_default: spi1-default-pins {
		pinmux = <ADSP_SC846_PD00__SPI1_CITO
			  ADSP_SC846_PD01__SPI1_COTI
			  ADSP_SC846_PD02__SPI1_SEL1
			  ADSP_SC846_PB10__SPI1_D2
			  ADSP_SC846_PB11__SPI1_D3
			  ADSP_SC846_PC15__SPI1_CLK>;
	};

	i2c5_pins: i2c5-default-pins {
		pinmux = <ADSP_SC846_PB02__TWI5_SCL
			  ADSP_SC846_PB03__TWI5_SDA>;
	};
};
