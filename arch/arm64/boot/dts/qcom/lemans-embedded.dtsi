		pins = "gpio60", "gpio61";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-up = <2200>;
	};

	cci0_0_sleep: cci0-0-sleep-state {
		pins = "gpio60", "gpio61";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-down;
	};

