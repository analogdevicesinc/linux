	clocks = <&rpmhcc RPMH_CXO_CLK>;
	clock-names = "xo";

	power-domains = <&rpmhpd SA8775P_CX>,
			<&rpmhpd SA8775P_MXC>;
	power-domain-names = "cx", "mxc";

	interconnects = <&gpdsp_anoc MASTER_DSP0 0
			 &config_noc SLAVE_CLK_CTL 0>;
