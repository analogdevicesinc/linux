#include "lemans.dtsi"

&tlmm {
	dp0_hot_plug_det: dp0-hot-plug-det-state {
		pins = "gpio101";
		function = "edp0_hot";
		bias-disable;
	};

	dp1_hot_plug_det: dp1-hot-plug-det-state {
		pins = "gpio102";
		function = "edp1_hot";
		bias-disable;
	};

	hs0_mi2s_active: hs0-mi2s-active-state {
		pins = "gpio114", "gpio115", "gpio116", "gpio117";
		function = "hs0_mi2s";
		drive-strength = <8>;
		bias-disable;
	};

	hs2_mi2s_active: hs2-mi2s-active-state {
		pins = "gpio122", "gpio123", "gpio124", "gpio125";
		function = "hs2_mi2s";
		drive-strength = <8>;
		bias-disable;
	};

	cci0_0_default: cci0-0-default-state {
		pins = "gpio60", "gpio61";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-up = <2200>;
	};

	cci0_0_sleep: cci0-0-sleep-state {
		pins = "gpio60", "gpio61";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-down;
	};

