					      <&smp2p_cdsp1_in 0 IRQ_TYPE_EDGE_RISING>,
					      <&smp2p_cdsp1_in 1 IRQ_TYPE_EDGE_RISING>,
					      <&smp2p_cdsp1_in 2 IRQ_TYPE_EDGE_RISING>,
