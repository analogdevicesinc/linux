			interrupts-extended = <&intc GIC_SPI 292 IRQ_TYPE_LEVEL_HIGH>,
					      <&intc GIC_SPI 287 IRQ_TYPE_LEVEL_HIGH>,
					      <&intc GIC_SPI 261 IRQ_TYPE_LEVEL_HIGH>,
