			iommus = <&apps_smmu 0x080 0x0>;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;

			usb-role-switch;
			dma-coherent;

			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					usb_0_dwc3_hs: endpoint {
					};
