			iommus = <&apps_smmu 0x140 0xf>;
			dma-coherent;

			snps,tso;
			snps,pbl = <32>;
			rx-fifo-depth = <16384>;
			tx-fifo-depth = <16384>;

			status = "disabled";
		};

