// SPDX-License-Identifier: GPL-2.0
/*
 * Device tree overlay for the ADRV9009-ZU11EG Rev.B SoM on the
 * ADRV2CRR-FMC Rev.B carrier, accessed from a PCIe host through the XDMA
 * (AXI-Bridge mode) endpoint. Includes JESD204 FSM (state machine) bindings.
 *
 * Combines the SoM and carrier device trees under linux/arch/arm64/boot/dts/
 * xilinx/:
 *   - zynqmp-adrv9009-zu11eg-reva.dtsi               (base SoM)
 *   - zynqmp-adrv9009-zu11eg-reva-adrv2crr-fmc-reva.dts  (base carrier)
 *   - zynqmp-adrv9009-zu11eg-revb.dtsi               (Rev.B SoM overrides)
 *   - zynqmp-adrv9009-zu11eg-revb-adrv2crr-fmc-revb.dts  (Rev.B carrier)
 *   - zynqmp-adrv9009-zu11eg-revb-adrv2crr-fmc-revb-jesd204-fsm.dts
 *                                                     (JESD204 FSM bindings)
 *
 * Deliberately omitted (PS-only or not reachable from a PCIe host):
 * dwc3_0/usb0, gem0/gem3, zynqmp_dpsub/dpdma, psgtr, i2c0/i2c1 (with all
 * of its i2c-mux children including adau1761, ad9545, PTN5150, EEPROMs),
 * pinctrl0 nodes, axi_i2s_adi (PS-hosted audio), ref_clk_0, audio_clock,
 * dpcon, talise_sound, phy_reset gpio-hog.
 *
 * Copyright (C) 2019-2026 Analog Devices Inc.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/iio/frequency/hmc7044.h>
#include <dt-bindings/iio/adc/adi,adrv9009.h>
#include <dt-bindings/jesd204/adxcvr.h>

#ifndef HMC7044_PLL2_OUTPUT_FREQUENCY
#define HMC7044_PLL2_OUTPUT_FREQUENCY	2949120000
#endif

/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target-path = "";

		__overlay__ {
			#address-cells = <3>;
			#size-cells = <2>;

			interrupt-controller;
			#interrupt-cells = <1>;

			pcie_axi_clk: pcie-clk-250000000 {
				#clock-cells = <0>;
				compatible = "fixed-clock";
				clock-frequency = <250000000>;
				clock-output-names = "pcie_axi_clk";
			};

			/*
			 * Consumer nodes (no reg / no BAR mapping). Kept above
			 * pci-ep-bus@0 because they only reference axi_gpio1
			 * phandles -- putting them under simple-bus triggers a
			 * dtc simple_bus_reg warning.
			 *
			 * Carrier peripherals driven from PL GPIO bus bits
			 * 0..11 (pb_gpio_0..3, dip_gpio_0..3, led_gpio_0..3):
			 * on axi_gpio1 channel 1, lines 0..11. Source:
			 * carrier DTS lines 60-140.
			 *
			 * Only led1..led3 are software-controllable. led_gpio_0
			 * (bus bit 8) is hardwired in system_top_pcie.v to the
			 * XDMA user_link_up output as a PCIe link-status LED.
			 */
			leds {
				compatible = "gpio-leds";
				led1 {
					label = "led1:green";
					gpios = <&axi_gpio1 9 GPIO_ACTIVE_HIGH>;
				};
				led2 {
					label = "led2:green";
					gpios = <&axi_gpio1 10 GPIO_ACTIVE_HIGH>;
				};
				led3 {
					label = "led3:green";
					gpios = <&axi_gpio1 11 GPIO_ACTIVE_HIGH>;
				};
			};

			/*
			 * Carrier push buttons (pb_gpio_0..3, bus bits 0..3) and
			 * DIP switches (dip_gpio_0..3, bus bits 4..7) are physical
			 * operator UI on the SoM. In this project the SoM's PS
			 * Linux still runs alongside PCIe, so gpio_keys stays in
			 * the PS-side device tree and is deliberately omitted from
			 * this PCIe overlay. axi_gpio1 lines 0..7 still expose the
			 * same pins to the PCIe host if a diagnostic needs them.
			 */

			axis_net: ethernet-axis {
				compatible = "adi,axis-net";
				dmas = <&axi_net_tx_dma 0>,
				       <&axi_net_rx_dma 0>;
				dma-names = "tx", "rx";
				local-mac-address = [02 0a 35 00 00 01];
			};

			pci-ep-bus@0 {
				compatible = "simple-bus";
				#address-cells = <1>;
				#size-cells = <1>;

				/*
				 * BAR0 (32 MB) maps to AXI 0x84000000 on the FPGA side.
				 * Two 64 kB blocks at the bottom are spoken for and
				 * neither may hold a node:
				 *
				 * 0x84000000-0x8400ffff belongs to the endpoint itself.
				 * Its MSI-X table and PBA are mapped here (BAR0+0x8000
				 * and +0x8fe0), and the hard block answers those
				 * accesses without passing them to the FPGA, so nothing
				 * placed behind them is reachable.
				 *
				 * 0x84010000-0x8401ffff is the interrupt controller,
				 * deliberately absent from this bus: pci-of-overlay
				 * reaches it directly at offset 0x10000 of BAR0 (see the
				 * interrupt comment on the parent node). The core
				 * decodes 16 address bits, so it claims the full block.
				 */
				ranges = <0x84000000 0x00 0x00 0x00 0x2000000>;

				axi_gpio1: gpio@84020000 {
					compatible = "xlnx,xps-gpio-1.00.a";
					reg = <0x84020000 0x1000>;
					clocks = <&pcie_axi_clk>;
					interrupts = <1>;
					#gpio-cells = <2>;
					gpio-controller;
					xlnx,gpio-width = <32>;
					xlnx,is-dual = <1>;
					xlnx,gpio2-width = <32>;
				};

				axi_gpio2: gpio@84030000 {
					compatible = "xlnx,xps-gpio-1.00.a";
					reg = <0x84030000 0x1000>;
					clocks = <&pcie_axi_clk>;
					interrupts = <2>;
					#gpio-cells = <2>;
					gpio-controller;
					xlnx,gpio-width = <31>;
					xlnx,is-dual = <0>;

					/*
					 * hmc7044_ext reset (bit 91 -> line 27) and
					 * vcxo_select (bit 92 -> line 28). On this carrier
					 * everything is routed through EMIO/PL fabric, so the
					 * expansion pins gpio_3_exp_n / gpio_4_exp_n *are*
					 * the hmc7044_ext RESET_HMC7044 / VCXO_SELECT nets.
					 * Bits 91/92 in gpio_i[94:0] land on axi_gpio2 lines
					 * 27/28 (see the GPIO remap table at the end of this
					 * file). The base carrier DTS hogs these via
					 * &gpio 169/170; the PCIe SoM boot DTS
					 * (..-fsm-pcie.dts) disables those PS-side hogs so
					 * only the PL side drives these nets.
					 */
					hmc7044_ext_reset_hog {
						gpio-hog;
						gpios = <27 GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "hmc7044_ext-reset";
					};

					hmc7044_ext_vcxo_select_hog {
						gpio-hog;
						gpios = <28 GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "hmc7044_ext-vcxo_select";
					};
				};

				/* ---------------------------------------------------
				 * PL SPI controller (replaces the PS EMIO SPI0).
				 * Hosts hmc7044 + the two adrv9009 phy nodes.
				 * --------------------------------------------------- */
				axi_spi: spi@84040000 {
					compatible = "xlnx,axi-quad-spi-3.2", "xlnx,xps-spi-2.00.a";
					reg = <0x84040000 0x1000>;
					clocks = <&pcie_axi_clk>, <&pcie_axi_clk>;
					clock-names = "s_axi_aclk", "ext_spi_clk";
					interrupts = <0>;
					interrupt-names = "ip2intc_irpt";

					bits-per-word = <8>;
					fifo-size = <16>;
					num-cs = <6>;
					xlnx,num-ss-bits = <6>;
					xlnx,spi-mode = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					hmc7044: hmc7044@2 {
						#address-cells = <1>;
						#size-cells = <0>;
						#clock-cells = <1>;
						compatible = "adi,hmc7044";
						reg = <2>;
						spi-max-frequency = <10000000>;

						/* Carrier hmc7044 output 2 feeds this SoM hmc7044
						 * as CLKIN1 (see the carrier DTS &hmc7044 override
						 * in zynqmp-adrv9009-zu11eg-reva-adrv2crr-fmc-reva.dts). */
						clocks = <&hmc7044_car 2>;
						clock-names = "clkin1";

						adi,pll1-clkin-frequencies = <30720000 30720000 0 0>;
						adi,pll1-ref-prio-ctrl = <0xE5>;
						adi,clkin0-buffer-mode = <0x09>;
						adi,clkin1-buffer-mode = <0x0b>;
						adi,sync-pin-mode = <1>;
						adi,pll1-loop-bandwidth-hz = <200>;
						adi,pfd1-maximum-limit-frequency-hz = <30720000>;
						adi,pll1-charge-pump-current-ua = <1920>;
						adi,vcxo-frequency = <122880000>;
						adi,pll2-output-frequency = <HMC7044_PLL2_OUTPUT_FREQUENCY>;
						adi,sysref-timer-divider = <3840>;
						/* JESD204 FSM: burst 16 sysref pulses (revb-fsm.dts). */
						adi,pulse-generator-mode = <HMC7044_PULSE_GEN_16_PULSE>;
						adi,oscin-buffer-mode = <0x15>;
						adi,gpi-controls = <0x00 0x00 0x00 0x11>;
						adi,gpo-controls = <0x1f 0x2b 0x00 0x00>;
						adi,high-performance-mode-clock-dist-enable;
						adi,hmc-two-level-tree-sync-en;

						/* JESD204 FSM: this HMC7044 receives sysref from
						 * the carrier HMC7044 and forwards it to all three
						 * link IPs (RX, ORX, TX deframer). */
						jesd204-device;
						#jesd204-cells = <2>;
						jesd204-inputs = <&hmc7044_car 0 FRAMER_LINK_RX>,
								 <&hmc7044_car 0 FRAMER_LINK_ORX>,
								 <&hmc7044_car 0 DEFRAMER_LINK_TX>;

						clock-output-names =
							"hmc7044_out0_DEV_REFCLK_A", "hmc7044_out1_DEV_SYSREF_A",
							"hmc7044_out2_DEV_REFCLK_B", "hmc7044_out3_DEV_SYSREF_B",
							"hmc7044_out4_JESD_REFCLK_TX_OBS_AB", "hmc7044_out5_JESD_REFCLK_RX_AB",
							"hmc7044_out6_CORE_CLK_TX_OBS_AB", "hmc7044_out7_CORE_CLK_RX_AB",
							"hmc7044_out8_FPGA_SYSREF_TX_OBS_AB", "hmc7044_out9_FPGA_SYSREF_RX_AB",
							"hmc7044_out10", "hmc7044_out11",
							"hmc7044_out12", "hmc7044_out13";

						hmc7044_c0: channel@0 {
							reg = <0>;
							adi,extended-name = "DEV_REFCLK_A";
							adi,divider = <12>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVDS>;
							adi,coarse-digital-delay = <15>;
						};
						/*
						 * Rev-B SoM: c1/c3/c8/c9 switch to LVPECL with
						 * force-mute; c6/c7 switch to CML. See
						 * zynqmp-adrv9009-zu11eg-revb.dtsi.
						 */
						hmc7044_c1: channel@1 {
							reg = <1>;
							adi,extended-name = "DEV_SYSREF_A";
							adi,divider = <3840>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVPECL>;
							adi,force-mute-enable;
							adi,startup-mode-dynamic-enable;
							adi,high-performance-mode-disable;
							adi,driver-impedance-mode = <HMC7044_DRIVER_IMPEDANCE_100_OHM>;
						};
						hmc7044_c2: channel@2 {
							reg = <2>;
							adi,extended-name = "DEV_REFCLK_B";
							adi,divider = <12>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVDS>;
							adi,coarse-digital-delay = <15>;
						};
						hmc7044_c3: channel@3 {
							reg = <3>;
							adi,extended-name = "DEV_SYSREF_B";
							adi,divider = <3840>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVPECL>;
							adi,force-mute-enable;
							adi,startup-mode-dynamic-enable;
							adi,high-performance-mode-disable;
							adi,driver-impedance-mode = <HMC7044_DRIVER_IMPEDANCE_100_OHM>;
						};
						hmc7044_c4: channel@4 {
							reg = <4>;
							adi,extended-name = "JESD_REFCLK_TX_OBS_AB";
							adi,divider = <12>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVDS>;
						};
						hmc7044_c5: channel@5 {
							reg = <5>;
							adi,extended-name = "JESD_REFCLK_RX_AB";
							adi,divider = <12>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVDS>;
						};
						hmc7044_c6: channel@6 {
							reg = <6>;
							adi,extended-name = "CORE_CLK_TX_OBS_AB";
							adi,divider = <24>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_CML>;
						};
						hmc7044_c7: channel@7 {
							reg = <7>;
							adi,extended-name = "CORE_CLK_RX_AB";
							adi,divider = <12>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_CML>;
						};
						hmc7044_c8: channel@8 {
							reg = <8>;
							adi,extended-name = "FPGA_SYSREF_TX_OBS_AB";
							adi,divider = <3840>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVPECL>;
							adi,force-mute-enable;
							adi,startup-mode-dynamic-enable;
							adi,high-performance-mode-disable;
						};
						hmc7044_c9: channel@9 {
							reg = <9>;
							adi,extended-name = "FPGA_SYSREF_RX_AB";
							adi,divider = <3840>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVPECL>;
							adi,force-mute-enable;
							adi,startup-mode-dynamic-enable;
							adi,high-performance-mode-disable;
						};
					};

					/*
					 * Carrier-board HMC7044 (reg=3 on the SPI bus). Provides
					 * the input reference clock for the SoM hmc7044 above
					 * (its output 2 -> SoM hmc7044 clkin1).
					 * Source: carrier DTS lines 458-559.
					 */
					hmc7044_car: hmc7044-car@3 {
						#address-cells = <1>;
						#size-cells = <0>;
						#clock-cells = <1>;
						compatible = "adi,hmc7044";
						reg = <3>;
						spi-max-frequency = <10000000>;

						/* Rev-B carrier PLL1 clkin setup (revb-adrv2crr-fmc-revb.dts). */
						adi,pll1-clkin-frequencies = <122880000 30720000 0 38400000>;
						adi,pll1-ref-prio-ctrl = <0xb1>;
						adi,pll1-ref-autorevert-enable;

						adi,pll1-loop-bandwidth-hz = <200>;
						adi,pfd1-maximum-limit-frequency-hz = <30720000>;
						adi,pll1-charge-pump-current-ua = <1920>;

						adi,vcxo-frequency = <122880000>;

						adi,pll2-output-frequency = <HMC7044_PLL2_OUTPUT_FREQUENCY>;

						adi,sysref-timer-divider = <3840>;
						/* JESD204 FSM: burst 16 sysref pulses, sync-pin passive. */
						adi,pulse-generator-mode = <HMC7044_PULSE_GEN_16_PULSE>;

						adi,oscin-buffer-mode = <0x15>;
						adi,clkin0-buffer-mode  = <0x07>;
						adi,clkin1-buffer-mode = <0x07>;
						adi,clkin3-buffer-mode = <0x11>;
						adi,sync-pin-mode = <0>;

						adi,hmc-two-level-tree-sync-en;

						adi,gpi-controls = <0x00 0x00 0x00 0x11>;
						adi,gpo-controls = <0x1f 0x2b 0x00 0x00>;

						/* JESD204 FSM: this hmc7044 is the sysref provider. */
						jesd204-device;
						#jesd204-cells = <2>;
						jesd204-sysref-provider;

						clock-output-names =
							"hmc7044_c_out0_REFCLK_OUT0", "hmc7044_c_out1",
							"hmc7044_c_out2_REFCLK_OUT2", "hmc7044_c_out3",
							"hmc7044_c_out4", "hmc7044_c_out5_SYNC_OUT1",
							"hmc7044_c_out6_SYNC_OUT2", "hmc7044_c_out7",
							"hmc7044_c_out8_REFCLK_OUT3", "hmc7044_c_out9_REFCLK_OUT4",
							"hmc7044_c_out10_REFCLK_QSFP", "hmc7044_c_out11_REFCLK_SFP",
							"hmc7044_c_out12", "hmc7044_c_out13";

						hmc7044_car_c0: channel@0 {
							reg = <0>;
							adi,extended-name = "REFCLK_OUT0";
							adi,divider = <96>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVDS>;
						};

						hmc7044_car_c2: channel@2 {
							reg = <2>;
							adi,extended-name = "REFCLK_OUT2";
							adi,divider = <96>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVPECL>;
						};

						hmc7044_car_c5: channel@5 {
							reg = <5>;
							adi,extended-name = "SYNC_OUT1";
							adi,divider = <3840>;
							adi,driver-mode = <3>;
							adi,startup-mode-dynamic-enable;
							adi,high-performance-mode-disable;
							adi,driver-impedance-mode = <3>;
						};

						hmc7044_car_c6: channel@6 {
							reg = <6>;
							adi,extended-name = "SYNC_OUT2";
							adi,divider = <3840>;
							adi,driver-mode = <3>;
							adi,startup-mode-dynamic-enable;
							adi,high-performance-mode-disable;
							adi,driver-impedance-mode = <3>;
						};

						hmc7044_car_c8: channel@8 {
							reg = <8>;
							adi,extended-name = "REFCLK_OUT3";
							adi,divider = <96>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVDS>;
						};

						hmc7044_car_c9: channel@9 {
							reg = <9>;
							adi,extended-name = "REFCLK_OUT4";
							adi,divider = <96>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVPECL>;
						};

						hmc7044_car_c10: channel@10 {
							reg = <10>;
							adi,extended-name = "REFCLK_QSFP";
							adi,divider = <96>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVPECL>;
						};

						hmc7044_car_c11: channel@11 {
							reg = <11>;
							adi,extended-name = "REFCLK_SFP";
							adi,divider = <24>;
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVPECL>;
						};
					};

					/*
					 * External HMC7044 on the carrier expansion connector,
					 * reached via spi_csn[4] -> gpio_0_exp_n (see
					 * system_top_pcie.v). Reset (axi_gpio2 line 27) and
					 * vcxo_select (axi_gpio2 line 28) are both PL-owned
					 * via the hogs above; the base carrier DTS's PS-side
					 * hmc7044_ext_reset / hmc7044_ext_vcxo_select hogs
					 * (&gpio 169/170) are disabled in the SoM boot DTS
					 * (..-fsm-pcie.dts) to avoid contention.
					 */
					hmc7044_ext: hmc7044-ext@4 {
						#address-cells = <1>;
						#size-cells = <0>;
						#clock-cells = <1>;
						compatible = "adi,hmc7044";
						reg = <4>;
						spi-max-frequency = <1000000>;

						adi,pll1-clkin-frequencies = <0 30720000 30720000 38400000>;

						adi,pll1-loop-bandwidth-hz = <200>;
						adi,pfd1-maximum-limit-frequency-hz = <3840000>;

						adi,pll1-ref-prio-ctrl = <0x39>; /* CLKIN1 -> CLKIN2 -> CLKIN3 -> CLKIN0 */
						adi,pll1-ref-autorevert-enable;

						adi,vcxo-frequency = <122880000>;

						adi,pll2-output-frequency = <HMC7044_PLL2_OUTPUT_FREQUENCY>;

						adi,sysref-timer-divider = <3840>;
						adi,pulse-generator-mode = <HMC7044_PULSE_GEN_1_PULSE>;

						adi,oscin-buffer-mode = <0x15>;
						adi,clkin1-buffer-mode = <0x07>;
						adi,clkin2-buffer-mode = <0x07>;
						adi,clkin3-buffer-mode = <0x07>;
						adi,sync-pin-mode = <1>;

						adi,gpi-controls = <0x00 0x00 0x00 0x00>;
						adi,gpo-controls = <0x1f 0x2b 0x00 0x00>;

						clock-output-names =
							"hmc7044_e_out0", "hmc7044_e_out1",
							"hmc7044_e_out2", "hmc7044_e_out3",
							"hmc7044_e_out4_SYNC_OUT1", "hmc7044_e_out5_REFCLK_OUT0",
							"hmc7044_e_out6_SYNC_OUT2", "hmc7044_e_out7",
							"hmc7044_e_out8", "hmc7044_e_out9",
							"hmc7044_e_out10", "hmc7044_e_out11",
							"hmc7044_e_out12_REFCLK_OUT2", "hmc7044_e_out13";

						hmc7044_ext_c4: channel@4 {
							reg = <4>;
							adi,extended-name = "SYNC_OUT1";
							adi,divider = <3840>;	/* 768000 */
							adi,driver-mode = <HMC7044_DRIVER_MODE_CMOS>;
							adi,startup-mode-dynamic-enable;
							adi,high-performance-mode-disable;
							adi,driver-impedance-mode = <HMC7044_DRIVER_IMPEDANCE_50_OHM>;
						};

						hmc7044_ext_c5: channel@5 {
							reg = <5>;
							adi,extended-name = "REFCLK_OUT0";
							adi,divider = <96>;	/* 3072000 */
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVPECL>;
						};

						hmc7044_ext_c6: channel@6 {
							reg = <6>;
							adi,extended-name = "SYNC_OUT2";
							adi,divider = <3840>;	/* 768000 */
							adi,driver-mode = <HMC7044_DRIVER_MODE_CMOS>;
							adi,startup-mode-dynamic-enable;
							adi,high-performance-mode-disable;
							adi,driver-impedance-mode = <HMC7044_DRIVER_IMPEDANCE_50_OHM>;
						};

						hmc7044_ext_c12: channel@12 {
							reg = <12>;
							adi,extended-name = "REFCLK_OUT2";
							adi,divider = <96>;	/* 3072000 */
							adi,driver-mode = <HMC7044_DRIVER_MODE_LVPECL>;
						};
					};

					/*
					 * ADRV9009 phy nodes. All non-GPIO property blocks
					 * (adi,jesd204-*, adi,rx-*, adi,orx-*, adi,tx-*,
					 * adi,dig-*, adi,rxagc-*, adi,aux-dac-*, adi,arm-gpio-*,
					 * adi,fhm-*, adi,rx*-gain-ctrl-*, adi,tx*-atten-*,
					 * adi,tx-pa-protection-*) are IDENTICAL to the SoM-side
					 * DTS at zynqmp-adrv9009-zu11eg-reva.dtsi lines 205-540
					 * (trx0) and 569-904 (trx1). Copy those blocks verbatim.
					 * Only the *-gpios references change (see the GPIO
					 * remap table at the end of this file); no node in
					 * this overlay carries an interrupt-parent.
					 */
					trx0_adrv9009: adrv9009-phy@0 {
						compatible = "adrv9009-x2";
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;

						spi-max-frequency = <25000000>;

						clocks = <&axi_adrv9009_rx_jesd>, <&axi_adrv9009_tx_jesd>,
							 <&axi_adrv9009_rx_os_jesd>, <&hmc7044 0>,
							 <&hmc7044 5>, <&hmc7044 1>, <&hmc7044 8>,
							 <&hmc7044 4>;
						clock-names = "jesd_rx_clk", "jesd_tx_clk", "jesd_rx_os_clk",
							      "dev_clk", "fmc_clk", "sysref_dev_clk",
							      "sysref_fmc_clk", "fmc2_clk";
						clock-output-names = "rx_sampl_clk", "rx_os_sampl_clk", "tx_sampl_clk";
						#clock-cells = <1>;

						/* JESD204 FSM: top device; owns the three links and
						 * pulls its per-link topology from trx1. Interrupts
						 * are managed by the FSM state machine (the reference
						 * DTS deletes interrupts here). */
						jesd204-device;
						#jesd204-cells = <2>;
						jesd204-top-device = <0>;
						jesd204-link-ids = <DEFRAMER_LINK_TX FRAMER_LINK_RX FRAMER_LINK_ORX>;
						jesd204-inputs =
							<&trx1_adrv9009 0 FRAMER_LINK_RX>,
							<&trx1_adrv9009 0 FRAMER_LINK_ORX>,
							<&trx1_adrv9009 0 DEFRAMER_LINK_TX>;

						reset-gpios       = <&axi_gpio1 52 GPIO_ACTIVE_HIGH>;
						test-gpios        = <&axi_gpio1 53 GPIO_ACTIVE_HIGH>;
						rx1-enable-gpios  = <&axi_gpio1 54 GPIO_ACTIVE_HIGH>;
						rx2-enable-gpios  = <&axi_gpio1 55 GPIO_ACTIVE_HIGH>;
						tx1-enable-gpios  = <&axi_gpio1 56 GPIO_ACTIVE_HIGH>;
						tx2-enable-gpios  = <&axi_gpio1 57 GPIO_ACTIVE_HIGH>;
						sysref-req-gpio   = <&axi_gpio2 25 GPIO_ACTIVE_HIGH>;

						/* JESD204 */

						/* JESD204 RX */
						adi,jesd204-framer-a-bank-id = <1>;
						adi,jesd204-framer-a-device-id = <0>;
						adi,jesd204-framer-a-lane0-id = <0>;
