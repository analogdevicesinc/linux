					};
				};

				/* ---------------------------------------------------
				 * TPL cores. Addresses unchanged from the SoM DTS.
				 * --------------------------------------------------- */
				axi_adrv9009_core_rx: axi-adrv9009-rx@84a00000 {
					compatible = "adi,axi-adrv9009-rx-1.0";
					reg = <0x84A00000 0x2000>;
					dmas = <&axi_adrv9009_som_rx_dma 0>;
					dma-names = "rx";
					spibus-connected = <&trx0_adrv9009>;
					adi,axi-pl-fifo-enable;
				};

				axi_adrv9009_core_tx: axi-adrv9009-tx@84a04000 {
					compatible = "adi,axi-adrv9009-x2-tx-1.0";
					reg = <0x84A04000 0x2000>;
					dmas = <&axi_adrv9009_som_tx_dma 0>;
					dma-names = "tx";
					clocks = <&trx0_adrv9009 2>;
					clock-names = "sampl_clk";
					spibus-connected = <&trx0_adrv9009>;
					adi,axi-pl-fifo-enable;
					/*
					 * dac_fifo_bypass was gpio_o[90] in the CPU-hosted
					 * design; bit 90 lives in axi_gpio2 (line 26).
					 */
					plddrbypass-gpios = <&axi_gpio2 26 GPIO_ACTIVE_HIGH>;

					/* JESD204 FSM link parent for trx1's DEFRAMER_LINK_TX. */
					jesd204-device;
					#jesd204-cells = <2>;
					jesd204-inputs = <&axi_adrv9009_tx_jesd 0 DEFRAMER_LINK_TX>;
				};

				axi_adrv9009_core_rx_obs: axi-adrv9009-rx-obs@84a08000 {
					compatible = "adi,axi-adrv9009-obs-1.0";
					reg = <0x84A08000 0x1000>;
					dmas = <&axi_adrv9009_som_obs_dma 0>;
					dma-names = "rx";
					clocks = <&trx0_adrv9009 1>;
					clock-names = "sampl_clk";
				};

				/* ---------------------------------------------------
				 * JESD204 transceiver + link IPs. Addresses unchanged.
				 * --------------------------------------------------- */

				axi_adrv9009_adxcvr_tx: axi-adxcvr-tx@84a20000 {
					#address-cells = <1>;
					#size-cells = <0>;
					compatible = "adi,axi-adxcvr-1.0";
					reg = <0x84A20000 0x1000>;
					/* JESD FSM: drop the div40 clock; the FSM state machine
					 * only needs "conv" -- see revb-fsm.dts &axi_adrv9009_adxcvr_tx. */
					clocks = <&hmc7044 4>;
					clock-names = "conv";
					#clock-cells = <1>;
					clock-output-names = "tx_gt_clk", "tx_out_clk";
					adi,sys-clk-select = <XCVR_QPLL>;
					adi,out-clk-select = <XCVR_REFCLK>;

					jesd204-device;
					#jesd204-cells = <2>;
					jesd204-inputs = <&hmc7044 0 DEFRAMER_LINK_TX>;
				};

				axi_adrv9009_tx_jesd: axi-jesd204-tx@84a30000 {
					compatible = "adi,axi-jesd204-tx-1.0";
					reg = <0x84A30000 0x1000>;
					clocks = <&pcie_axi_clk>, <&hmc7044 6>, <&axi_adrv9009_adxcvr_tx 0>;
					clock-names = "s_axi_aclk", "device_clk", "lane_clk";
					interrupts = <7>;
					#clock-cells = <0>;
					clock-output-names = "jesd_tx_lane_clk";
					adi,octets-per-frame = <2>;
					adi,frames-per-multiframe = <32>;
					adi,converter-resolution = <14>;
					adi,bits-per-sample = <16>;
					adi,converters-per-device = <4>;
					adi,control-bits-per-sample = <2>;

					jesd204-device;
					#jesd204-cells = <2>;
					jesd204-inputs = <&axi_adrv9009_adxcvr_tx 0 DEFRAMER_LINK_TX>;
				};

				axi_adrv9009_adxcvr_rx: axi-adxcvr-rx@84a40000 {
					#address-cells = <1>;
					#size-cells = <0>;
					compatible = "adi,axi-adxcvr-1.0";
					reg = <0x84A40000 0x1000>;
					clocks = <&hmc7044 5>;
					clock-names = "conv";
					#clock-cells = <1>;
					clock-output-names = "rx_gt_clk", "rx_out_clk";
					adi,sys-clk-select = <XCVR_CPLL>;
					adi,out-clk-select = <XCVR_REFCLK>;
					adi,use-lpm-enable;

					jesd204-device;
					#jesd204-cells = <2>;
					jesd204-inputs = <&hmc7044 0 FRAMER_LINK_RX>;
				};

				axi_adrv9009_rx_jesd: axi-jesd204-rx@84a50000 {
					compatible = "adi,axi-jesd204-rx-1.0";
					reg = <0x84A50000 0x1000>;
					clocks = <&pcie_axi_clk>, <&hmc7044 7>, <&axi_adrv9009_adxcvr_rx 0>;
					clock-names = "s_axi_aclk", "device_clk", "lane_clk";
					interrupts = <8>;
					#clock-cells = <0>;
					clock-output-names = "jesd_rx_lane_clk";
					adi,octets-per-frame = <4>;
					adi,frames-per-multiframe = <32>;

					jesd204-device;
					#jesd204-cells = <2>;
					jesd204-inputs = <&axi_adrv9009_adxcvr_rx 0 FRAMER_LINK_RX>;
				};

				axi_adrv9009_adxcvr_rx_os: axi-adxcvr-rx-os@84a60000 {
					#address-cells = <1>;
					#size-cells = <0>;
					compatible = "adi,axi-adxcvr-1.0";
					reg = <0x84A60000 0x1000>;
					clocks = <&hmc7044 4>;
					clock-names = "conv";
					#clock-cells = <1>;
					clock-output-names = "rx_os_gt_clk", "rx_os_out_clk";
					adi,sys-clk-select = <XCVR_CPLL>;
					adi,out-clk-select = <XCVR_REFCLK>;
					adi,use-lpm-enable;

					jesd204-device;
					#jesd204-cells = <2>;
					jesd204-inputs = <&hmc7044 0 FRAMER_LINK_ORX>;
				};

				axi_adrv9009_rx_os_jesd: axi-jesd204-rx-os@84a70000 {
					compatible = "adi,axi-jesd204-rx-1.0";
					reg = <0x84A70000 0x1000>;
					clocks = <&pcie_axi_clk>, <&hmc7044 6>, <&axi_adrv9009_adxcvr_rx_os 0>;
					clock-names = "s_axi_aclk", "device_clk", "lane_clk";
					interrupts = <6>;
					#clock-cells = <0>;
					clock-output-names = "jesd_rx_os_lane_clk";
					adi,octets-per-frame = <4>;
					adi,frames-per-multiframe = <32>;

					jesd204-device;
					#jesd204-cells = <2>;
					jesd204-inputs = <&axi_adrv9009_adxcvr_rx_os 0 FRAMER_LINK_ORX>;
				};

				/* ---------------------------------------------------
				 * axi_dmac controllers. SG enabled, 64-bit addressing,
				 * all six ASYNC_CLK_* flags asserted. Data paths reach
				 * host RAM via S_AXI_B; register map is here in BAR0.
				 * The three DMAs moved from 0x9C4x_0000 into the BAR
				 * window so a single 32 MB BAR covers everything.
				 * --------------------------------------------------- */

				axi_adrv9009_som_tx_dma: dma-controller@84c00000 {
					compatible = "adi,axi-dmac-1.00.a";
					reg = <0x84C00000 0x1000>;
					clocks = <&pcie_axi_clk>;
					#dma-cells = <1>;
					#clock-cells = <0>;
					dma-coherent;
					interrupts = <4>;
				};

				axi_adrv9009_som_rx_dma: dma-controller@84c10000 {
					compatible = "adi,axi-dmac-1.00.a";
					reg = <0x84C10000 0x1000>;
					clocks = <&pcie_axi_clk>;
					#dma-cells = <1>;
					#clock-cells = <0>;
					dma-coherent;
					interrupts = <5>;
				};

				axi_adrv9009_som_obs_dma: dma-controller@84c20000 {
					compatible = "adi,axi-dmac-1.00.a";
					reg = <0x84C20000 0x1000>;
					clocks = <&pcie_axi_clk>;
					#dma-cells = <1>;
					#clock-cells = <0>;
					dma-coherent;
					interrupts = <3>;
				};

				/* ---------------------------------------------------
				 * HOST end of the host<->PS network link.
				 * --------------------------------------------------- */

				axi_net_tx_dma: dma-controller@84c30000 {
					compatible = "adi,axi-dmac-1.00.a";
					reg = <0x84C30000 0x1000>;
					clocks = <&pcie_axi_clk>;
					#dma-cells = <1>;
					#clock-cells = <0>;
					dma-coherent;
					interrupts = <9>;
				};

				axi_net_rx_dma: dma-controller@84c40000 {
					compatible = "adi,axi-dmac-1.00.a";
					reg = <0x84C40000 0x1000>;
					clocks = <&pcie_axi_clk>;
					#dma-cells = <1>;
					#clock-cells = <0>;
					dma-coherent;
					interrupts = <10>;
				};

				/* ---------------------------------------------------
				 * System ID ROM. Address unchanged from the SoM DTS.
				 * --------------------------------------------------- */
				axi_sysid_0: axi-sysid-0@85000000 {
					compatible = "adi,axi-sysid-1.00.a";
					reg = <0x85000000 0x1000>;
				};
			};
		};
	};
};

/*
 * ==============================================================================
 * GPIO remap notes
 * ==============================================================================
 *
 * In the SoM-side DTS the ADRV9009 phy nodes reference the PS GPIO controller
 * with EMIO-relative indices >= 78 (Linux gpio-zynqmp numbering: MIO 0..77 +
 * EMIO 78..173). The FPGA-side gpio_i/o/t buses are 95-bit and land on
 * axi_gpio1 (bus bits 0..63) + axi_gpio2 (bus bits 64..94).
 *
 * Conversion: bus_bit = dts_index - 78, then:
 *   bus_bit  0..31 -> axi_gpio1 line bus_bit          (channel 1)
 *   bus_bit 32..63 -> axi_gpio1 line bus_bit          (channel 2; the
 *                                                     xilinx-gpio driver
 *                                                     flattens both channels
 *                                                     into a single line space)
 *   bus_bit 64..94 -> axi_gpio2 line (bus_bit - 64)
 *
 * Reference table:
 *
 *   Old ref                    bus bit    New reference
 *   Carrier (adrv2crr-fmc-reva.dts):
 *   &gpio  78 (bt0)                0     <&axi_gpio1 0 0>
 *   &gpio  79 (bt1)                1     <&axi_gpio1 1 0>
 *   &gpio  80 (bt2)                2     <&axi_gpio1 2 0>
 *   &gpio  81 (bt3)                3     <&axi_gpio1 3 0>
 *   &gpio  82 (sw0)                4     <&axi_gpio1 4 0>
 *   &gpio  83 (sw1)                5     <&axi_gpio1 5 0>
 *   &gpio  84 (sw2)                6     <&axi_gpio1 6 0>
 *   &gpio  85 (sw3)                7     <&axi_gpio1 7 0>
 *   &gpio  86 (led0)               8     hardwired to user_link_up in
 *                                         system_top_pcie.v line 305; used as
 *                                         a PCIe-link-status LED and NOT
 *                                         software-controllable.
 *   &gpio  87 (led1)               9     <&axi_gpio1 9 0>
 *   &gpio  88 (led2)              10     <&axi_gpio1 10 0>
 *   &gpio  89 (led3)              11     <&axi_gpio1 11 0>
 *   (hmc7044_ext_rst, ext_vcxo)   --     hmc7044_ext (reg=4) is not wired in
 *                                         system_top_pcie.v; the corresponding
 *                                         gpio-hogs from the carrier DTS are
 *                                         intentionally omitted.
 *
 *   SoM (zynqmp-adrv9009-zu11eg-reva.dtsi lines 1394-1411):
 *   &gpio 130 (reset0)            52     <&axi_gpio1 52 0>
 *   &gpio 131 (test0)             53     <&axi_gpio1 53 0>
 *   &gpio 132 (rx1_en0)           54     <&axi_gpio1 54 0>
 *   &gpio 133 (rx2_en0)           55     <&axi_gpio1 55 0>
 *   &gpio 134 (tx1_en0)           56     <&axi_gpio1 56 0>
 *   &gpio 135 (tx2_en0)           57     <&axi_gpio1 57 0>
 *   &gpio 156 (reset1)            78     <&axi_gpio2 14 0>
 *   &gpio 157 (test1)             79     <&axi_gpio2 15 0>
 *   &gpio 158 (rx1_en1)           80     <&axi_gpio2 16 0>
 *   &gpio 159 (rx2_en1)           81     <&axi_gpio2 17 0>
 *   &gpio 160 (tx1_en1)           82     <&axi_gpio2 18 0>
 *   &gpio 161 (tx2_en1)           83     <&axi_gpio2 19 0>
 *   &gpio 167 (sysref)            89     <&axi_gpio2 25 0>
 *   &gpio 168 (fifo bp)           90     <&axi_gpio2 26 0>   (in axi_adrv9009_core_tx)
 *
 * Verify each mapping against the actual gpio_i/gpio_o/gpio_t wiring in
 * projects/adrv9009zu11eg/adrv2crr_fmc/system_top_pcie.v before deploying;
 * the SoM/carrier plumbing may steer specific EMIO lines to different bus
 * positions than the naive dts_index - 78 formula suggests.
 */
