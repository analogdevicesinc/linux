/*
 * dts file for Custom ZynqMP ZU3EG board
 *
 * hdl_project: <adrv9004>
 * board_revision: <>
 *
 * Copyright (C) 2026
 */

/dts-v1/;

#include "zynqmp.dtsi"
#include "zynqmp-clk-ccf.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/iio/adc/adi,adrv9002.h>

/ {
	model = "Custom ZynqMP";
	compatible = "xlnx,zynqmp";

	aliases {
		i2c0 = &i2c0;
		mmc0 = &sdhci0;
		rtc0 = &rtc;
		serial0 = &uart1;
		serial1 = &uart0;
		spi0 = &qspi;
		spi1 = &spi0;
	};

	chosen {
		bootargs = "console=ttyPS0,115200 earlycon clk_ignore_unused root=/dev/mmcblk0p2 rw rootwait";
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x80000000>; /* 2GB */
	};

	fpga_axi: axi_pl {
		interrupt-parent = <&gic>;
		compatible = "simple-bus";
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges = <0 0 0 0xffffffff>;

		rx1_dma: dma-controller@84a30000 {
			compatible = "adi,axi-dmac-1.00.a";
			reg = <0x84a30000 0x10000>;
			#dma-cells = <1>;
			dma-coherent;
			interrupts = <0 109 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&zynqmp_clk 71>;
		};

		rx2_dma: dma-controller@84a40000 {
			compatible = "adi,axi-dmac-1.00.a";
			reg = <0x84a40000 0x10000>;
			#dma-cells = <1>;
			dma-coherent;
			interrupts = <0 108 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&zynqmp_clk 71>;
		};

		tx1_dma: dma-controller@84a50000 {
			compatible = "adi,axi-dmac-1.00.a";
			reg = <0x84a50000 0x10000>;
			#dma-cells = <1>;
			dma-coherent;
			interrupts = <0 107 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&zynqmp_clk 71>;
		};

		tx2_dma: dma-controller@84a60000 {
			compatible = "adi,axi-dmac-1.00.a";
			reg = <0x84a60000 0x10000>;
			#dma-cells = <1>;
			dma-coherent;
			interrupts = <0 106 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&zynqmp_clk 71>;
		};

		axi_adrv9004_core_rx1: axi-adrv9004-rx-lpc@84a00000 {
			compatible = "adi,axi-adrv9004-rx-1.0";
			reg = <0x84a00000 0x6000>;
			clocks = <&adc0_adrv9004 0>;
			dmas = <&rx1_dma 0>;
			dma-names = "rx";
			spibus-connected = <&adc0_adrv9004>;
		};

		axi_adrv9004_core_tx1: axi-adrv9004-tx-lpc@84a0a000 {
			compatible = "adi,axi-adrv9004-tx-1.0";
			reg = <0x84a0a000 0x2000>;
			clocks = <&adc0_adrv9004 1>;
			clock-names = "sampl_clk";
			dmas = <&tx1_dma 0>;
			dma-names = "tx";
			adi,axi-dds-default-scale = <0x800>;
			adi,axi-dds-default-frequency = <2000000>;
		};

		axi_adrv9004_core_rx2: axi-adrv9004-rx2-lpc@84a09000 {
			compatible = "adi,axi-adrv9004-rx2-1.0";
			reg = <0x84a09000 0x1000>;
			clocks = <&adc0_adrv9004 3>;
			clock-names = "sampl_clk";
			dmas = <&rx2_dma 0>;
			dma-names = "rx";
		};

		axi_adrv9004_core_tx2: axi-adrv9004-tx2-lpc@84a0c000 {
			compatible = "adi,axi-adrv9004-tx-1.0";
			reg = <0x84a0c000 0x2000>;
			clocks = <&adc0_adrv9004 4>;
			clock-names = "sampl_clk";
			dmas = <&tx2_dma 0>;
			dma-names = "tx";
			adi,axi-dds-default-scale = <0x800>;
			adi,axi-dds-default-frequency = <2000000>;
		};

		axi_sysid_0: axi-sysid-0@85000000 {
			compatible = "adi,axi-sysid-1.00.a";
			reg = <0x85000000 0x10000>;
		};
	};
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&sdhci0 {
	status = "okay";
	disable-wp;
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;
};

&qspi {
	status = "okay";
	is-dual = <0>;
	num-cs = <1>;
};

&spi0 {
	status = "okay";
};

&gpio {
	status = "okay";
};

&rtc {
	status = "disabled";
};

&watchdog0 {
	status = "okay";
};

&xilinx_ams {
	status = "okay";
};

&ams_ps {
	status = "okay";
};

&ams_pl {
	status = "okay";
};

&psgtr {
	status = "okay";
};

#define fmc_spi spi0

/ {
	clocks {
		adrv9004_clkin: clock@0 {
			compatible = "fixed-clock";

			clock-frequency = <38400000>;
			clock-output-names = "adrv9004_ext_refclk";
			#clock-cells = <0>;
		};
	};
};

&fmc_spi {
	status = "okay";

	adc0_adrv9004: adrv9004-phy@0 {
		compatible = "adi,adrv9004";
		reg = <0>;

		interrupt-parent = <&gpio>;
		reset-gpios = <&gpio 81 GPIO_ACTIVE_LOW>;
		interrupts = <78 IRQ_TYPE_EDGE_RISING>;

		spi-max-frequency = <20000000>;
		/* Clocks */
		clocks = <&adrv9004_clkin>;
		clock-names = "adrv9002_ext_refclk";
		clock-output-names = "rx1_sampl_clk", "tx1_sampl_clk", "tdd1_intf_clk",
				"rx2_sampl_clk", "tx2_sampl_clk", "tdd2_intf_clk";
		#clock-cells = <1>;

		adi,channels {
			#address-cells = <1>;
			#size-cells = <0>;

			rx0: rx@0 {
				reg = <0>;
				adi,port = <0>;
				enable-gpios = <&gpio 125 GPIO_ACTIVE_HIGH>;
				mux-ctl-gpios = <&gpio 86 GPIO_ACTIVE_HIGH>;
			};

			rx1: rx@1 {
				reg = <1>;
				adi,port = <0>;
				enable-gpios = <&gpio 124 GPIO_ACTIVE_HIGH>;
				mux-ctl-gpios = <&gpio 88 GPIO_ACTIVE_HIGH>;
			};

			tx0: tx@0 {
				reg = <0>;
				adi,port = <1>;
				adi,dpd;
				mux-ctl-gpios = <&gpio 90 GPIO_ACTIVE_HIGH>;
				enable-gpios = <&gpio 123 GPIO_ACTIVE_HIGH>;
			};

			tx1: tx@1 {
				reg = <1>;
				adi,port = <1>;
				adi,dpd;
				mux-ctl-gpios = <&gpio 92 GPIO_ACTIVE_HIGH>;
				enable-gpios = <&gpio 122 GPIO_ACTIVE_HIGH>;
			};

		};

		adi,gpios {
			#address-cells = <1>;
			#size-cells = <0>;

			gpio@0 {
				reg = <ADRV9002_DGPIO_0>;
				adi,signal = <ADRV9002_GPIO_SIGNAL_ORX_ENABLE_1>;
			};

			gpio@1 {
				reg = <ADRV9002_DGPIO_1>;
				adi,signal = <ADRV9002_GPIO_SIGNAL_ORX_ENABLE_2>;
			};
		};

		/* Frequency hopping properties */
		adi,frequency-hopping {
			adi,fh-mode = <ADRV9002_FH_LO_RETUNE_REALTIME_PROCESS_DUAL_HOP>;
			adi-fh-rx-zero-if-en;

			/* Depends on @adi,fh-mode being set to dual hop */
			adi,fh-hop-signal-2 {
				adi,fh-hop-rx-ports = <ADRV9002_RX_2>;
				adi,fh-hop-tx-ports = <ADRV9002_TX_2>;
			};
		};
	};
};

