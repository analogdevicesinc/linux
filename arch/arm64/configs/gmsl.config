# ADI GMSL configuration fragment, applied on top of the Tegra defconfig:
#   make defconfig gmsl.config
CONFIG_I2C_ATR=m
CONFIG_I2C_MUX=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_MAX96717=m
CONFIG_VIDEO_MAX96724=m
CONFIG_VIDEO_MAX9296A=m
# Tegra GMSL overlays use NVIDIA's tegracam nv_imx219 (nvidia-oot). The mainline
# driver matches the same compatible and registers the same driver name.
# CONFIG_VIDEO_IMX219 is not set
# Release string comes from LOCALVERSION only (no git suffix).
# CONFIG_LOCALVERSION_AUTO is not set
