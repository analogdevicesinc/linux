# Jetson (Tegra234) settings for the upstream-based kernel that NVIDIA's own
# kernel config has and the arm64 defconfig does not:
#   make defconfig gmsl.config tegra-upstream.config
#
# UEFI hands the boot framebuffer over as /chosen/framebuffer (simple-framebuffer)
# referencing the display power domain and clocks. simpledrm must be built in so
# it holds them until nvidia-drm takes over; otherwise the "disp" power domain is
# switched off as unused at late init and the display firmware (DCE) times out,
# leaving no DisplayPort output.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
