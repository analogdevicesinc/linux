# RF Transceivers and Advanced Mixed Signal Frontends drivers
#
menu "RF Transceivers and Advanced Mixed Signal Frontends"

config AD9088
	tristate "Analog Devices AD9088 and similar Mixed Signal Front End (MxFE)"
	depends on SPI
	select CF_AXI_ADC
	select ADI_AXI_HSCI
	help
	  Say yes here to build support for Analog Devices:
	  AD9088, AD9084 mixed signal front end (MxFE).
	  Provides direct access via sysfs.

config ADRV903X
	tristate "Analog Devices ADRV903X/ADRV9030 RF Transceiver driver"
	depends on SPI
	select CF_AXI_ADC
	help
	  Say yes here to build support for Analog Devices:
	  ADRV903X/ADRV9030 RF Transceivers. Provides direct access
	  via sysfs.

	  To compile this driver as a module, choose M here: the module will be
	  called adrv903x_drv.

config ADRV9104
	tristate "Analog Devices ADRV9104 RF Transceiver driver"
	depends on SPI
	select IIO_BACKEND
	select FW_LOADER
	select FW_UPLOAD
	help
	  Say yes to build support for the Analog Devices ADRV9102 integrated
	  RF transceiver and similar devices.

	  To compile this driver as a module, choose M here: the module will be
	  called adrv9104_drv

config ADRV9104_COMMON_VERBOSE
	bool "Enables verbose error reports"
	depends on ADRV9104
	default y

config ADRV9104_ARM_VERBOSE
	bool "Enables ARM verbose error messages"
	depends on ADRV9104
	default y

config ADRV9104_VALIDATE_PARAMS
	bool "Causes the API to validate all the input parameters"
	depends on ADRV9104
	default y

config ADRV9104_KUNIT_TEST
	tristate "KUnit tests for the ADRV9104 device profile parser" if !KUNIT_ALL_TESTS
	depends on ADRV9104 && KUNIT
	default KUNIT_ALL_TESTS
	help
	  Build KUnit tests that load a device profile via request_firmware(),
	  parse it and serialise it back, validating the JSON parser/serialiser.
	  Useful to check whether the parser needs updating after an SDK bump.

	  If unsure, say N.
endmenu
