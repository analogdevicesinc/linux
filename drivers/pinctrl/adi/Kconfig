config PINCTRL_ADI_ADSP
	tristate "Analog Devices ADSP pinctrl and GPIO driver"
	depends on OF
	select PINMUX
	select PINCONF
	select GENERIC_PINCONF
	select GENERIC_PINCTRL_GROUPS
	select GENERIC_PINMUX_FUNCTIONS
	select GPIOLIB
	select GPIOLIB_IRQCHIP
	select IRQ_DOMAIN_HIERARCHY
	select MFD_SYSCON
	imply ADI_ADSP_PINT
	help
	  This pinctrl driver provides an interface that allows configuring the
	  PORT pins on Analog Devices ADSP SoCs. The pins can be muxed to
	  another peripheral, or function as GPIO.

	  The driver can also be built as a module. If so, the module will be
	  called pinctrl-adsp.

config PINCTRL_ADI_ADSP_SRU
	bool "ADSP-SC5XX SRU control driver"
	depends on ADI_ADSP_DAI
	default ADI_ADSP_DAI
	select GENERIC_PINCONF
	select PINMUX
	help
	  Say Y here to enable the ADSP-SC5XX SRU control driver. This is
	  required for SRU muxing functionality on the SoC.
